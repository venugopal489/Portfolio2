* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial;
  scroll-behavior: smooth;
}

body {
  background: #f5f5f5;
}

nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 50px;
  background: #0f172a;
  color: white;
}

nav ul {
  display: flex;
  list-style: none;
  gap: 20px;
}

nav a {
  color: white;
  text-decoration: none;
}

.hero {
  height: 90vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #2563eb;
  color: white;
}

button {
  padding: 12px 25px;
  margin-top: 20px;
  border: none;
  background: white;
  color: #2563eb;
  border-radius: 30px;
  cursor: pointer;
}

section {
  padding: 60px;
  text-align: center;
}

.skills {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.skills div {
  background: #2563eb;
  color: white;
  padding: 15px 30px;
  border-radius: 10px;
}

.projects {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 30px;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 0 10px gray;
}

@media(max-width:768px) {
  
  nav {
    flex-direction: column;
  }
  
  nav ul {
    flex-direction: column;
    margin-top: 10px;
  }
  
  .projects {
    grid-template-columns: 1fr;
  }
  
}